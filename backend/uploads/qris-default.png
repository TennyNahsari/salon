<svg xmlns="http://www.w3.org/2000/svg" width="300" height="380" viewBox="0 0 300 380">
  <rect width="300" height="380" fill="#ffffff" rx="16" ry="16" stroke="#2F5D62" stroke-width="2"/>
  <rect x="0" y="0" width="300" height="50" fill="#2F5D62" rx="16" ry="16"/>
  <rect x="0" y="30" width="300" height="20" fill="#2F5D62"/>
