  <text x="150" y="95" font-family="sans-serif" font-size="12" fill="#8A8A8A" text-anchor="middle">NMID: ID1029384756102</text>
  
  <!-- QR Code Mock Pattern -->
  <g transform="translate(45, 110)">
    <rect width="210" height="210" fill="#ffffff" stroke="#D4AF37" stroke-width="3" rx="8"/>
