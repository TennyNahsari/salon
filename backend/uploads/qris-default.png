    <rect x="23" y="23" width="34" height="34" fill="#ffffff"/>
    <rect x="30" y="30" width="20" height="20" fill="#2F5D62"/>
    
    <rect x="145" y="15" width="50" height="50" fill="#1E2A2F"/>
    <rect x="153" y="23" width="34" height="34" fill="#ffffff"/>
    <rect x="160" y="30" width="20" height="20" fill="#2F5D62"/>
    
    <rect x="15" y="145" width="50" height="50" fill="#1E2A2F"/>
    <rect x="23" y="153" width="34" height="34" fill="#ffffff"/>
    <rect x="30" y="160" width="20" height="20" fill="#2F5D62"/>

    <!-- Data Mock Pixels -->
    <rect x="75" y="20" width="15" height="15" fill="#1E2A2F"/>
    <rect x="100" y="20" width="30" height="10" fill="#2F5D62"/>
    <rect x="80" y="45" width="40" height="15" fill="#1E2A2F"/>
    <rect x="20" y="80" width="40" height="15" fill="#2F5D62"/>
    <rect x="75" y="75" width="60" height="60" fill="#D4AF37"/>
    <rect x="85" y="85" width="40" height="40" fill="#1E2A2F"/>
    <rect x="150" y="80" width="35" height="35" fill="#2F5D62"/>
    <rect x="145" y="130" width="45" height="15" fill="#1E2A2F"/>
    <rect x="80" y="150" width="25" height="40" fill="#2F5D62"/>
    <rect x="115" y="160" width="40" height="25" fill="#D4AF37"/>
